{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "kali_lab": {
      "type": "stdio",
      "command": "ssh",
      "args": [
        "-T",
        "-o", "BatchMode=yes",
        "-o", "ConnectTimeout=8",
        "-o", "ServerAliveInterval=30",
        "-o", "ServerAliveCountMax=3",
        "kali-lab",
        "mcp-server",
        "--server",
        "http://127.0.0.1:5000"
      ],
      "cwd": "${PLUGIN_ROOT}"
    }
  }
}
